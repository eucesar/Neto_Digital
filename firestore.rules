rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /eventos/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['sessaoId','tipo','tela','alvo','risco','timestamp'])
        && request.resource.data.sessaoId is string && request.resource.data.sessaoId.size() <= 64
        && request.resource.data.tipo is string && request.resource.data.tipo.size() <= 40
        && request.resource.data.timestamp == request.time;
      allow update, delete: if false;
    }

    match /alertas/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['sessaoId','tipo_golpe','acao_tomada','timestamp'])
        && request.resource.data.sessaoId is string && request.resource.data.sessaoId.size() <= 64
        && request.resource.data.tipo_golpe is string && request.resource.data.tipo_golpe.size() <= 40
        && request.resource.data.acao_tomada is string && request.resource.data.acao_tomada.size() <= 40
        && request.resource.data.timestamp == request.time;
      allow update, delete: if false;
    }

    match /sessoes/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['sessaoId','inicio','dispositivo'])
        && request.resource.data.sessaoId is string && request.resource.data.sessaoId.size() <= 64
        && request.resource.data.dispositivo is string && request.resource.data.dispositivo.size() <= 40
        && request.resource.data.inicio == request.time;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
